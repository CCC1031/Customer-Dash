# ============================================================================
# SNAXOLOGY CUSTOMER PORTAL - PRODUCTION FRONTEND CONFIGURATION
# ============================================================================

# API Configuration
VITE_API_URL=https://api.snaxology.com/api
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME=Snaxology Customer Portal
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production

# Feature Flags
VITE_FEATURE_HAHA_INTEGRATION=true
VITE_FEATURE_ADVANCED_ANALYTICS=true
VITE_FEATURE_REAL_TIME_UPDATES=true

# Analytics (Optional)
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_ID=your-analytics-id

# Error Tracking (Optional)
VITE_SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# Performance
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_LOG_LEVEL=warn

# Security
VITE_SECURE_COOKIES=true
VITE_ENABLE_SECURITY_HEADERS=true
